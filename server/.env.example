NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_dashboard
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Model providers (all optional; the offline demo model always works) ---
ANTHROPIC_API_KEY=
# AWS Bedrock: set BEDROCK_ENABLED=true. Credentials come from the standard AWS chain
# (these env vars, ~/.aws/credentials with AWS_PROFILE, or an IAM role).
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Comma-separated Bedrock model IDs to offer, e.g. amazon.nova-pro-v1:0,amazon.nova-lite-v1:0
BEDROCK_MODELS=amazon.nova-pro-v1:0,amazon.nova-lite-v1:0,meta.llama3-1-70b-instruct-v1:0
